    "   \"id\": \"edb5093e\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Optional: Compare different logit gaps quickly\\n\",\n",
    "    \"\\n\",\n",
    "    \"This cell sweeps a \\\"gap\\\" between top-2 logits and plots where gradients peak.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"82674e22\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-13T11:55:42.526073477Z\",\n",
    "     \"start_time\": \"2026-01-13T11:55:39.934859283Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def run_gap_sweep(gaps, taus, K=5, base=0.0, n_samples=4000, seed=0):\\n\",\n",
    "    \"    out = []\\n\",\n",
    "    \"    for gap in gaps:\\n\",\n",
    "    \"        # logits: top class has value gap, second is 0, rest negative\\n\",\n",
    "    \"        logits = np.array([gap, 0.0, -0.5, -1.0, -1.5])[:K]\\n\",\n",
    "    \"        jf = []\\n\",\n",
    "    \"        for tau in taus:\\n\",\n",
    "    \"            Jstats = jacobian_stats_over_samples(logits, tau, n_samples=1200, seed=seed)\\n\",\n",
    "    \"            jf.append(Jstats[\\\"frob_mean\\\"])\\n\",\n",
    "    \"        out.append(np.array(jf))\\n\",\n",
    "    \"    return np.array(out)\\n\",\n",
    "    \"\\n\",\n",
    "    \"gaps = [0.0, 0.2, 0.5, 1.0, 2.0]\\n\",\n",
    "    \"jf_mat = run_gap_sweep(gaps, taus, K=K, n_samples=4000, seed=seed)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(8,5))\\n\",\n",
    "    \"plt.xscale('log')\\n\",\n",
    "    \"for i, gap in enumerate(gaps):\\n\",\n",
    "    \"    plt.plot(taus, jf_mat[i], label=f'gap={gap}')\\n\",\n",
    "    \"plt.xlabel('tau (log scale)')\\n\",\n",
    "    \"plt.ylabel('E[||J||_F]')\\n\",\n",
    "    \"plt.title('Effect of logit gap on gradient scale vs tau')\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.show()\\n\"\n",
    "   ],\n",
