    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"taus_to_show = [2.0, 1.0, 0.5, 0.2]\\n\",\n",
    "    \"taus_to_show = [t for t in taus_to_show if (t >= taus.min() and t <= taus.max())]\\n\",\n",
    "    \"\\n\",\n",
    "    \"for tau in taus_to_show:\\n\",\n",
    "    \"    y = gumbel_softmax_samples(logits, tau, n_samples=20000, seed=seed)\\n\",\n",
    "    \"    mean_y = y.mean(axis=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"tau={tau:.3f}  mean probs={np.round(mean_y, 4)}  entropy(mean)={entropy(mean_y):.3f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.figure(figsize=(7,4))\\n\",\n",
    "    \"    plt.hist(np.max(y, axis=1), bins=40)\\n\",\n",
    "    \"    plt.xlabel('max(y)')\\n\",\n",
    "    \"    plt.ylabel('count')\\n\",\n",
    "    \"    plt.title(f'Histogram of max(y) at tau={tau:.3f}')\\n\",\n",
    "    \"    plt.show()\\n\"\n",
