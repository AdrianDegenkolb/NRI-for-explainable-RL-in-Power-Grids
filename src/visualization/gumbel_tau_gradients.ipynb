    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"33aed897\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Plot 2: Gradient sensitivity w.r.t logits (softmax Jacobian norms)\\n\",\n",
    "    \"\\n\",\n",
    "    \"We summarize the Jacobian \\\\(J = \\\\partial y / \\\\partial l\\\\) per sample and average over Gumbel noise.\\n\",\n",
    "    \"\\n\",\n",
    "    \"- Frobenius norm: overall gradient scale.\\n\",\n",
    "    \"- Max absolute entry: worst-case sensitivity.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Typical pattern:\\n\",\n",
    "    \"- As τ decreases, there is an initial increase due to \\\\(1/\\\\tau\\\\),\\n\",\n",
    "    \"- followed by a decrease as outputs saturate (near one-hot) causing \\\\(y(1-y)\\\\to 0\\\\).\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"e318194c\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-13T11:51:48.241369699Z\",\n",
    "     \"start_time\": \"2026-01-13T11:51:47.729771098Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"fig = plt.figure(figsize=(8,5))\\n\",\n",
    "    \"plt.xscale('log')\\n\",\n",
    "    \"plt.plot(stats[\\\"tau\\\"], stats[\\\"J_frob_mean\\\"], label='E[||J||_F]')\\n\",\n",
    "    \"plt.plot(stats[\\\"tau\\\"], stats[\\\"J_frob_p90\\\"], label='P90(||J||_F)', linestyle='--')\\n\",\n",
    "    \"plt.xlabel('tau (log scale)')\\n\",\n",
    "    \"plt.ylabel('Jacobian Frobenius norm')\\n\",\n",
    "    \"plt.title('Gradient scale vs tau (Frobenius norm)')\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig = plt.figure(figsize=(8,5))\\n\",\n",
    "    \"plt.xscale('log')\\n\",\n",
    "    \"plt.plot(stats[\\\"tau\\\"], stats[\\\"J_maxabs_mean\\\"], label='E[max|J_ij|]')\\n\",\n",
    "    \"plt.plot(stats[\\\"tau\\\"], stats[\\\"J_maxabs_p90\\\"], label='P90(max|J_ij|)', linestyle='--')\\n\",\n",
    "    \"plt.xlabel('tau (log scale)')\\n\",\n",
    "    \"plt.ylabel('Max absolute Jacobian entry')\\n\",\n",
    "    \"plt.title('Worst-case sensitivity vs tau')\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.show()\\n\"\n",
